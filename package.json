{
  "name": "romulus-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "refine dev",
    "build": "tsc && refine build",
    "deploy": "vercel --prod --yes",
    "format": "prettier --write \"./**/*.{ts,tsx,html,yaml,md,json,txt}\"",
    "lint": "eslint \"./**/*.js\"",
    "start": "refine start"
